---
pagination:
    data: collections.blogPosts
    size: 5
    alias: posts
permalink: "blog{% if pagination.pageNumber > 0 %}/page/{{ pagination.pageNumber + 1 }}{% endif %}/index.html"
layout: base.njk
title: Blog
---

<h1>Blog</h1>

<ul>
    {% for post in posts %}
    <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
    {% endfor %}
</ul>

{% if pagination.pages.length > 1 %}
<nav aria-label="Pagination">
    <ul>
        {% if pagination.pageNumber > 0 %}
        <li><a href="{{ pagination.href.previous }}">Previous</a></li>
        {% endif %}
        {% for pageNumber in pagination.pages %}
        {% set activeClass = pagination.pageNumber == pageNumber ? 'active' : '' %}
        <li>
            <a href="{{ pagination.hrefs[pageNumber] }}"
               class="{{ activeClass }}">
                {{ pageNumber + 1 }}
            </a>
        </li>
        {% endfor %}
        {% if pagination.pageNumber < pagination.pages.length - 1 %}
        <li><a href="{{ pagination.href.next }}">Next</a></li>
        {% endif %}
    </ul>
</nav>
{% endif %}
